# Окружение: development | test | production
NODE_ENV=development

# Порт бэкенд-сервера
# 3001 — для режима разработки с Vite (Vite на 5173 проксирует /api на 3001)
# 4173 — для запуска сервера с самостоятельной раздачей собранного web/dist
PORT=3001

# Разрешённый Origin клиентского приложения (для проверки заголовков Origin и CSRF)
# http://127.0.0.1:5173 — при разработке через Vite dev-сервер (порты должны совпадать с Vite)
# http://127.0.0.1:4173 — при автономном запуске сервера с раздачей web/dist
PUBLIC_ORIGIN=http://127.0.0.1:5173

# Путь к файлу базы данных SQLite
DATABASE_PATH=./marshrut.sqlite

# Учебные/демо-аккаунты
DEMO_PATIENT_USERNAME=patient_demo
DEMO_PATIENT_PASSWORD=patient123
DEMO_STAFF_USERNAME=staff_demo
DEMO_STAFF_PASSWORD=staff123
# Опционально: дополнительный список в формате JSON или user:pass:role,...
# Примеры:
# - Разделитель-двоеточие: user1:pass1:patient,user2:pass2:staff
# - JSON-массив: [{"username":"demo_user","password":"demo_password","role":"patient","description":"Доп. пациент"}]
DEMO_ACCOUNTS=
# Автоматическое сидирование при старте сервера в dev-режиме (true/false, по умолчанию true в development)
AUTO_SEED_DEMO=true
